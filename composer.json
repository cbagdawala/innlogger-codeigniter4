{
    "name": "cbagdawala/innlogger-codeigniter4",
    "description": "InnLogger SDK for CodeIgniter 4: signed, fail-silent application logging to an InnLogger portal.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["codeigniter4", "logging", "innlogger", "monitoring", "hmac"],
    "authors": [
        {
            "name": "Chintan Bagdawala",
            "email": "chintan@bagdawala.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "codeigniter4/framework": "^4.4",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "codeigniter4/framework": "^4.4 is required for the Services, Config, spark command, log handler and exception handler integration"
    },
    "autoload": {
        "psr-4": {
            "InnLogger\\CodeIgniter4\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InnLogger\\CodeIgniter4\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
